#!/usr/bin/env bash
set -euo pipefail

lang="${BOUKENSHA_LANG:-ruby}"
[[ "${1:-}" == "--python" ]] && lang="python"

case "$lang" in
  ruby)
    cd "$(dirname "$0")/../ruby/09_global_executable"
    bundle exec ruby bin/boukensha
    ;;
  python)
    cd "$(dirname "$0")/../python/09_global_executable"
    uv run python bin/boukensha
    ;;
  *)
    echo "unknown BOUKENSHA_LANG: $lang" >&2
    exit 1
    ;;
esac
