# Windows Zone.Identifier files (WSL download metadata)
*Zone.Identifier

# Environment / secrets
.env
.env.localcl

#don't commit node modules
*node_modules/*

# generated CircleMUD world JSON (rebuild from infrastructure/lib/world via the parser)
week0_explore/preview/data/world/

# The agent's own runtime state. knowledge.sqlite3 is the map it EARNED by
# walking; committing it would ship one machine's exploration as if it were
# source, and the monitor reads it live. Telnet / manager logs stay local.
# Session JSONL and the CDC journal are committed so week-2 debugging and
# writeups can cite real turns.
.boukensha/knowledge.sqlite3
.boukensha/knowledge.sqlite3-*
.boukensha/telnet/
.boukensha/manager/

# A profile's own runtime, per directory. `profile.yaml` itself is NOT ignored:
# it is configuration, it holds no secret (the password comes from settings.yaml
# or a named env var), and a working example of one is worth having in a repo
# whose whole point is teaching.
# Session transcripts and journal JSONL under profiles/*/ ARE tracked (see above).
.boukensha/profiles/*/knowledge.sqlite3
.boukensha/profiles/*/knowledge.sqlite3-*
.boukensha/profiles/*/telnet/
.boukensha/profiles/*/manager/

# Bundler installs into the project because /opt/homebrew's gem dir is not
# writable here (`bundle config set --local path vendor/bundle`).
**/vendor/bundle/
.bundle/